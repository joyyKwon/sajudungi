{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sajudungi-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "port": 8081
    },
    {
      "name": "sajudungi-dev-client",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--dev-client", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "sajudungi-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--directory", "dist-site"],
      "port": 4173
    }
  ]
}
